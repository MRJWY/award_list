# Paste the full service account JSON as a single-line JSON string.
GOOGLE_SERVICE_ACCOUNT_JSON = "{\"type\":\"service_account\",\"project_id\":\"...\"}"

# Set the approved Excel government total in thousands of KRW and its source date.
# Keep real financial values in private Secrets only. Blank values show as missing.
ANNUAL_BUDGET_2026_GOVERNMENT_KKRW = ""
ANNUAL_BUDGET_2026_AS_OF = ""
